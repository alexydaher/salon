<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Salon</name>
  <summary>Launch apps from the sofa</summary>

  <description>
    <p>
      Salon turns a GNOME machine into a television. It is a fullscreen
      launcher meant to be read from a sofa and driven with six buttons: a
      game controller, a TV remote over HDMI-CEC, or the arrow keys. Rows of
      large tiles, one cursor, and no window controls anywhere.
    </p>
    <p>
      It launches what is already installed. A tile can be an installed
      application, a web address opened fullscreen in its own browser
      profile, or a command; the catalogue lives in one JSON file that can be
      edited by hand or from the on-screen editor, and providers can add rows
      of their own.
    </p>
    <p>Built for the room rather than the desk:</p>
    <ul>
      <li>Every size is a design unit resolved against the real monitor, so
      the same layout reads correctly on a 1080p set and a 4K one.</li>
      <li>Search with an on-screen keyboard, or by typing on a phone on the
      same network.</li>
      <li>Settings and the tile editor are reachable
      without a keyboard or a mouse.</li>
      <li>A gamepad can drive the pointer, so browser-hosted streaming
      services that expect a mouse still work.</li>
      <li>Network and battery status, volume, and HDMI-CEC in both
      directions.</li>
    </ul>
    <p>
      Salon does not configure the system. Wi-Fi, displays, date and time and
      the rest are handed to GNOME Settings, because a launcher has no
      business re-implementing them for a D-pad.
    </p>
    <p>
      The Flatpak runs Salon as a fullscreen application. Flatpak cannot add
      a Salon or Salon Kiosk choice to the login screen, so install Salon as
      a native system package for the dedicated television session. Two
      things the sandbox withholds are unprompted input injection and the
      autostart entry; both fall back to something that works.
    </p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <categories>
    <category>Utility</category>
    <category>System</category>
  </categories>

  <keywords>
    <keyword>launcher</keyword>
    <keyword>television</keyword>
    <keyword>ten-foot</keyword>
    <keyword>controller</keyword>
    <keyword>gamepad</keyword>
    <keyword>remote</keyword>
    <keyword>CEC</keyword>
    <keyword>kiosk</keyword>
  </keywords>

  <!-- Salon is a full-screen interface for a room, not a window on a desk.
       It has no phone or tablet form factor and never will. -->
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <requires>
    <display_length compare="ge">1024</display_length>
  </requires>

  <recommends>
    <control>gamepad</control>
  </recommends>

  <!-- The application id claims github.com/alexydaher, which is what
       Flathub checks the submitter controls. These stay in step with the id:
       change one and the rest have to move with it. -->
  <url type="homepage">https://github.com/alexydaher/salon</url>
  <url type="bugtracker">https://github.com/alexydaher/salon/issues</url>
  <url type="vcs-browser">https://github.com/alexydaher/salon</url>
  <url type="contribute">https://github.com/alexydaher/salon</url>

  <developer id="io.github.alexydaher">
    <name>Alexy Daher</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#C47712</color>
    <color type="primary" scheme_preference="dark">#E8A33D</color>
  </branding>

  <!-- Pinned to the v0.3.4 tag rather than to main: a software centre
       showing this release should show the screenshots that release shipped
       with, and a moving branch would let them drift. Bump these with the
       version. -->
  <screenshots>
    <screenshot type="default">
      <caption>The home screen: rows of tiles, one focused</caption>
      <image type="source" width="1280" height="720">https://raw.githubusercontent.com/alexydaher/salon/v0.3.4/docs/screenshots/home.png</image>
    </screenshot>
    <screenshot>
      <caption>Search, with the on-screen keyboard on the left</caption>
      <image type="source" width="1280" height="720">https://raw.githubusercontent.com/alexydaher/salon/v0.3.4/docs/screenshots/search.png</image>
    </screenshot>
    <screenshot>
      <caption>Settings, in the home screen's own visual language</caption>
      <image type="source" width="1280" height="720">https://raw.githubusercontent.com/alexydaher/salon/v0.3.4/docs/screenshots/settings.png</image>
    </screenshot>
    <screenshot>
      <caption>The tile editor, driven entirely from a controller</caption>
      <image type="source" width="1280" height="720">https://raw.githubusercontent.com/alexydaher/salon/v0.3.4/docs/screenshots/tile-editor.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.3.4" date="2026-08-29">
      <description>
        <p>Settings is reorganized around eight sections with live summaries, visual value controls, per-setting defaults, and a guided television setup, while tile editing gains a real preview, artwork picker, accent swatches, and one clear position control.</p>
        <p>Audio outputs and controller bindings now have readable names, audio can play a test sound, tile settings can be backed up and restored, and the phone remote can tune previewable picture settings over the live television view.</p>
      </description>
    </release>
    <release version="0.3.3" date="2026-08-29">
      <description>
        <p>Appearance choices now open over the real home screen and preview each candidate as the cursor moves, so theme, accent and layout values can be judged where they actually take effect.</p>
        <p>OK keeps the previewed choice, Back restores the value that was active before the list opened, and pointer clicks follow the same preview flow as controller input.</p>
      </description>
    </release>
    <release version="0.3.2" date="2026-08-29">
      <description>
        <p>Release quality gates and publication now share one tag-triggered GitHub Actions run, so a release commit no longer starts separate branch, tag, gate, and publishing workflows.</p>
        <p>Pull requests exercise the same quality-gate job without entering any tag-only packaging or publication job.</p>
      </description>
    </release>
    <release version="0.3.1" date="2026-08-29">
      <description>
        <p>The tile-size preference now controls the All Applications grid as well as Home, recomputing its column count immediately so smaller tiles fit more applications and larger tiles remain an equally direct choice.</p>
        <p>Flatpak catalogue rendering now treats host desktop entries that are invisible inside the sandbox as artless tiles with generated fallback artwork, rather than allowing PyGObject's NULL-constructor exception to interrupt layout and stack every row at the same position.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-08-29">
      <description>
        <p>Tiles are now proportional objects: the tile-size preference scales their type, padding, glow and row headings together, so a smaller card stays readable and the shipped default fits several more rows on screen than the design size did.</p>
        <p>Home carries one cursor column across every row, tints the focus ring with the artwork it surrounds, moves now playing into the top bar with its cover art and a click to pause, adds play/pause to game controllers, and falls back to an application's own desktop-entry icon before drawing a generated card.</p>
        <p>The phone remote is rebuilt around a persistent header and three panes, with a measured volume popover, typing folded into the pointer pane, a corrected A-Z index rail, and accented application names filed under their own letter.</p>
        <p>Scrolling no longer renders full-screen offscreen images every frame, an absent controller no longer wakes the main loop sixty times a second, and the Flatpak regains power, network, Bluetooth, HDMI-CEC, GNOME Settings and on-screen keyboard support.</p>
        <p>The phone remote can no longer lock a household out of its own television: stale credentials are rejected without spending an attempt, lockouts expire, and a server that cannot bind leaves nothing behind.</p>
      </description>
    </release>
    <release version="0.2.11" date="2026-08-26">
      <description>
        <p>Home now presents device-aware button legends, independent row positions, clearer edge fades, calmer detail chrome, and a compact nested power menu.</p>
        <p>The phone remote gains full app browsing, synchronized typing, now-playing artwork, persistent global controls, swipe and accelerated pointer gestures, and responsive landscape layouts.</p>
        <p>Refactored remote assets and server components add strict resource routing, installation-completeness checks, and broader navigation, accessibility, and rendering coverage.</p>
      </description>
    </release>
    <release version="0.2.10" date="2026-08-25">
      <description>
        <p>The top bar's shortcut buttons are round again and each icon sits in the centre of its button, with the phone connection dot on the glyph rather than below it.</p>
      </description>
    </release>
    <release version="0.2.9" date="2026-08-25">
      <description>
        <p>Flatpak release validation now follows the Advanced input panel and initializes D-Bus correctly in minimal build environments.</p>
      </description>
    </release>
    <release version="0.2.8" date="2026-08-25">
      <description>
        <p>Flatpak installations now discover the host's desktop applications, restoring the complete All Apps catalogue inside the sandbox.</p>
        <p>The Home screen presents application logos directly, uses compact idle shortcuts, and recolours the wallpaper from the focused app without blurring its artwork into the background.</p>
      </description>
    </release>
    <release version="0.2.7" date="2026-08-25">
      <description>
        <p>The Home screen gains a restrained ambient background, unified icon medallions, clearer shortcut controls, focused-row emphasis and a compact glass detail card.</p>
        <p>Backdrop feedback now starts sooner and settles more smoothly while preserving custom wallpaper and reduced-motion behavior.</p>
      </description>
    </release>
    <release version="0.2.6" date="2026-08-25">
      <description>
        <p>Confirmation-first destructive actions, direct keyboard input, consistent controls, contextual hints and unified tile actions make Salon safer and easier to operate from every input source.</p>
        <p>Search, Settings, reordering, phone controls, scrolling, file selection and configuration testing now provide clearer state and more predictable navigation.</p>
      </description>
    </release>
    <release version="0.2.5" date="2026-08-25">
      <description>
        <p>Appearance settings now scroll completely to the final row even when text and padding make rows taller than their nominal size.</p>
      </description>
    </release>
    <release version="0.2.4" date="2026-08-25">
      <description>
        <p>Fresh installs now receive a short, detected set of TV-friendly applications while every starter tile remains editable in Settings.</p>
        <p>The streaming row adds Disney+ and YouTube, prefers an installed GeForce NOW launcher, and safely upgrades only untouched older starter catalogues.</p>
      </description>
    </release>
    <release version="0.2.3" date="2026-08-25">
      <description>
        <p>Salon now ships a native Debian package alongside its AMD64 and ARM64 Flatpak bundles.</p>
        <p>A project-hosted, OpenPGP-signed Flatpak repository provides one-click installation and automatic updates independently of Flathub.</p>
      </description>
    </release>
    <release version="0.2.2" date="2026-08-25">
      <description>
        <p>Configuration, browser launching, audio, network requests, artwork caching, and portal input are hardened against malformed input and unavailable host services.</p>
        <p>Flatpak Settings now report unavailable host integrations honestly, and the release includes reproducible Wayland, sandbox, and crash-recovery gates.</p>
      </description>
    </release>
    <release version="0.2.1" date="2026-08-25">
      <description>
        <p>Settings now follow controller-first navigation, and the status bar shows connected controllers and phones.</p>
        <p>The Flatpak uses input-device-only access and no longer requests host dconf or power permissions.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-08-25">
      <description>
        <p>The phone remote is now a second screen with the catalogue, a D-pad, a trackpad, a keyboard, volume and playback controls.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-19">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
