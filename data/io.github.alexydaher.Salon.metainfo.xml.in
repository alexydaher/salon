<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Salon</name>
  <summary>A ten-foot launcher for GNOME</summary>

  <description>
    <p>
      Salon turns a GNOME machine into a television. It is a fullscreen
      launcher meant to be read from a sofa and driven with six buttons: a
      game controller, a TV remote over HDMI-CEC, or the arrow keys. Rows of
      large tiles, one cursor, and no window controls anywhere.
    </p>
    <p>
      It launches what is already installed. A tile can be an installed
      application, a web address opened fullscreen in its own browser
      profile, or a command; the catalogue lives in one JSON file that can be
      edited by hand or from the on-screen editor, and providers can add rows
      of their own.
    </p>
    <p>Built for the room rather than the desk:</p>
    <ul>
      <li>Every size is a design unit resolved against the real monitor, so
      the same layout reads correctly on a 1080p set and a 4K one.</li>
      <li>Search with an on-screen keyboard, or by typing on a phone on the
      same network.</li>
      <li>Settings, the tile editor and the power menu are all reachable
      without a keyboard or a mouse.</li>
      <li>A gamepad can drive the pointer, so browser-hosted streaming
      services that expect a mouse still work.</li>
      <li>Network and battery status, volume, and HDMI-CEC in both
      directions.</li>
    </ul>
    <p>
      Salon does not configure the system. Wi-Fi, displays, date and time and
      the rest are handed to GNOME Settings, because a launcher has no
      business re-implementing them for a D-pad.
    </p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <categories>
    <category>Utility</category>
    <category>System</category>
  </categories>

  <keywords>
    <keyword>launcher</keyword>
    <keyword>television</keyword>
    <keyword>ten-foot</keyword>
    <keyword>controller</keyword>
    <keyword>gamepad</keyword>
    <keyword>remote</keyword>
    <keyword>CEC</keyword>
    <keyword>kiosk</keyword>
  </keywords>

  <!-- Salon is a full-screen interface for a room, not a window on a desk.
       It has no phone or tablet form factor and never will. -->
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <requires>
    <display_length compare="ge">1024</display_length>
  </requires>

  <recommends>
    <control>gamepad</control>
  </recommends>

  <!-- The application id already claims this domain, and Flathub checks that
       the submitter controls it. If salon.rocks isn't registered, the id is
       what has to change — not just this line. -->
  <url type="homepage">https://salon.rocks/</url>

  <developer id="io.github.alexydaher">
    <name>Alexy Daher</name>
  </developer>

  <!-- No screenshot entries yet: AppStream requires absolute URLs for them
       and there is no public repository serving docs/screenshots/ to point
       at. Add them here in the same commit that publishes the repository —
       the images themselves are already in the tree. -->

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-08-19">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
