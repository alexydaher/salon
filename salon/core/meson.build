python_sources = [
  '__init__.py',
  'actions.py',
  'errors.py',
  'model.py',
  'nowplaying.py',
  'catalog.py',
  'bindings.py',
  'provider.py',
  'sandbox.py',
  'session.py',
  'config.py',
  'focus.py',
  'gamelib.py',
  'game_library.py',
  'launchspec.py',
  'editing.py',
  'tile_editing.py',
  'osk.py',
  'qr.py',
  'qr_codewords.py',
  'qr_penalty.py',
  'remote.py',
  'remote_feed.py',
  'network_addresses.py',
  'ranking.py',
  'siteicon.py',
  'status.py',
  'tokens.py',
]

foreach f : python_sources
  configure_file(
    input: f,
    output: f,
    copy: true,
    install: true,
    install_dir: moduledir / 'core',
  )
endforeach
