python_sources = [
  '__init__.py',
  'context.py',
  'widgets.py',
  'action_rows.py',
  'settings_list.py',
  'settings_row.py',
  'value_rows.py',
  'popup.py',
  'popup_option.py',
  'panels.py',
  'about_panel.py',
  'appearance_panel.py',
  'audio_panel.py',
  'bindings_panel.py',
  'bluetooth_panel.py',
  'browser_panel.py',
  'input_panel.py',
  'network_panel.py',
  'navigation_policy.py',
  'preview_policy.py',
  'system_panel.py',
  'tiles.py',
  'add_tile_panels.py',
  'row_panels.py',
  'reorder_panels.py',
  'tile_details.py',
  'tile_panel.py',
  'providers.py',
  'screen.py',
  'screen_actions.py',
  'screen_navigation.py',
  'screen_preview.py',
  'screen_shared.py',
  'screen_state.py',
]

foreach f : python_sources
  configure_file(
    input: f,
    output: f,
    copy: true,
    install: true,
    install_dir: moduledir / 'ui' / 'settings',
  )
endforeach
